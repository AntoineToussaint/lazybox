{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lazybox:schema:theme:v1",
  "title": "Lazybox theme",
  "description": "A theme file in the Runner's themes folder (Settings → Appearance). Set the base tokens; the others derive from them.",
  "type": "object",
  "required": [
    "name",
    "appearance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The name Settings shows."
    },
    "appearance": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Whether this is a dark or a light theme."
    },
    "scheme": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Another name for appearance."
    },
    "extends": {
      "enum": [
        "dark",
        "light",
        "dark-high-contrast",
        "solarized-light",
        "dracula",
        "one-dark-pro",
        "tokyo-night",
        "catppuccin-mocha",
        "catppuccin-latte",
        "github-dark-default",
        "github-light-default",
        "light-high-contrast"
      ],
      "description": "A built-in theme of the same appearance to start from."
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "description": "Token = colour. A leading -- is accepted.",
      "properties": {
        "bg": {
          "type": "string",
          "description": "Behind everything: the window background. (Surfaces, base)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-sunken": {
          "type": "string",
          "description": "Recessed areas: the sidebar, wells, code. (Surfaces)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface": {
          "type": "string",
          "description": "The main canvas: pages, panels and the chat. (Surfaces, base)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-raised": {
          "type": "string",
          "description": "Cards, inputs, menus and dialogs. (Surfaces, base)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-hover": {
          "type": "string",
          "description": "A row or control under the pointer. (Surfaces)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-active": {
          "type": "string",
          "description": "A pressed control or an active row. (Surfaces)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-selected": {
          "type": "string",
          "description": "The selected row, tab or item. (Surfaces)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "surface-strong": {
          "type": "string",
          "description": "Strong neutral fills: scroll thumbs, toggles, badges. (Surfaces)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
        },
        "line-subtle": {
          "type": "string",
          "description": "Dividers between rows. (Lines)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\(.*\\))$"
