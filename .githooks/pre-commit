#!/usr/bin/env bash
# lazybox pre-commit hook.
#
# Two depths, selected by the `lazybox.precommitFull` git config flag:
#
#   * Default (flag unset) — auto-format only. ~1s, no cargo build, no
#     build-lock contention. Runs `cargo fmt --all` in place and
#     re-stages the touched files so the commit lands formatted with no
#     round-trip. This is what `scripts/bootstrap.sh` installs for
#     everyone, and it's safe to run concurrently across worktrees
#     (multiple agent sessions committing at once won't deadlock on the
#     shared target/ build lock).
#
#   * Full (flag = true) — fmt + clippy + rustdoc, the exact CI gates, so
#     a clippy warning or a broken doc link never leaves the laptop. Opt
#     in with `make install-hooks`, which sets the flag. Heavier (a full
#     workspace build); avoid it where many worktrees commit in parallel.
#     It also regenerates the generated wire contracts, but only on a
#     commit that stages a DTO source (a cheap `git diff --cached` guard
#     keeps that ~11-min build off every other commit) — see step 4.
#
# Bypass for a one-off "I know what I'm doing" commit:
#     git commit --no-verify
# (Don't do this on the shared branch.)

set -euo pipefail

# Full gate only when explicitly opted in (set by `make install-hooks`).
full="$(git config --bool --get lazybox.precommitFull 2>/dev/null || true)"

# Honor lazybox's pinned zig if present — same resolution run.sh and the
# Makefile use so anything the hook spawns picks up zig 0.15.2 instead
# of whatever brew put on PATH (ghostty's build.zig rejects 0.16).
# `make setup` drops the binary under a host-specific dir; glob for it
# rather than assuming a fixed path. A per-worktree `vendor/zig/` wins
# when present (a worktree can pin its own zig); otherwise fall back to
# the shared cache at `${LAZYBOX_ZIG_CACHE:-~/.cache/lazybox/zig}/` (one
# download shared across all worktrees).
repo_root="$(git rev-parse --show-toplevel)"
zig_cache="${LAZYBOX_ZIG_CACHE:-${HOME}/.cache/lazybox/zig}"
zig_bin=""
for root in "${repo_root}/vendor/zig" "${zig_cache}"; do
    [ -d "${root}" ] || continue
    zig_bin="$(find "${root}" -maxdepth 2 -name zig -type f 2>/dev/null | head -n1)"
    [ -n "${zig_bin}" ] && break
done
if [ -n "${zig_bin}" ]; then
    export PATH="$(dirname "${zig_bin}"):${PATH}"
fi

# 1. Auto-format. Run rustfmt in place, then re-stage exactly the Rust
#    files that were already staged for this commit, so it lands
#    formatted with no manual round-trip. Same `cargo fmt --all` the CI
#    fmt job checks — fast, takes no build lock, safe across parallel
#    worktrees.
#
#    Caveat: a re-staged file is added whole, so a *partially* staged
#    file (some hunks staged, others not) has its unstaged hunks pulled
#    in too. Stage whole files, or `git commit --no-verify` for a
#    deliberate partial commit.
staged_rs="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')"
echo "pre-commit: cargo fmt --all"
if ! cargo fmt --all; then
    cat <<EOF >&2

pre-commit: cargo fmt failed (a syntax error in a staged file?).
Fix it and re-commit, or bypass with \`git commit --no-verify\`.
EOF
    exit 1
fi
if [ -n "${staged_rs}" ]; then
    # Re-stage only the already-staged Rust files (whole-file add).
    printf '%s\n' "${staged_rs}" | while IFS= read -r f; do
        [ -n "${f}" ] || continue
        git add -- "${f}"
    done
    echo "pre-commit: re-staged formatted files"
fi

# Fast path stops here. Clippy + rustdoc only run under the full gate
# (`make install-hooks`); the default fmt-only hook is done.
if [ "${full}" != "true" ]; then
    echo "pre-commit: ok (fmt only — \`make install-hooks\` adds clippy + rustdoc)"
    exit 0
fi

# 2. Clippy on the staged tree. Slower but catches the things CI
#    catches before they need a re-push round-trip. Same flags CI
#    uses.
echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    cat <<EOF >&2

pre-commit: clippy warnings above. Fix them or bypass with
\`git commit --no-verify\`.
EOF
    exit 1
fi

# 3. Rustdoc with warnings-as-errors — catches broken intra-doc links
#    (`[\`Foo\`]` pointing at a symbol that isn't in scope). Same
#    RUSTDOCFLAGS + invocation the CI rustdoc job runs. Cheap once the
#    clippy build above has warmed the cache.
echo "pre-commit: RUSTDOCFLAGS=-D warnings cargo doc --no-deps --workspace"
if ! RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --workspace --quiet; then
    cat <<EOF >&2

pre-commit: rustdoc errors above (usually a broken intra-doc link —
a \`[\`Symbol\`]\` whose target isn't imported in that module). Fix the
link or bypass with \`git commit --no-verify\`.
EOF
    exit 1
fi

# 4. Regenerate the generated wire contracts, but ONLY when this commit
#    stages a fingerprint input (ipc/core/tui-core wire types, the
#    api-gateway module, or Cargo.lock — a lock bump moves the fingerprint
#    baked into the fixture). The guard is a cheap `git diff --cached`; the heavy build
#    runs only on the rare commit that can actually move a fixture, and
#    the regenerated files are re-staged into this commit — so DTO drift
#    is caught here instead of turning a teammate's CI red. Skips silently
#    (no build) on every commit that touches no DTO.
echo "pre-commit: regen contracts (only if DTO sources are staged)"
if ! "${repo_root}/scripts/regen-contracts.sh" --if-staged; then
    cat <<EOF >&2

pre-commit: contract regeneration failed above. Fix the DTO change (or
run \`make contracts\` by hand) and re-commit, or bypass with
\`git commit --no-verify\`.
EOF
    exit 1
fi

echo "pre-commit: ok"
