<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice (VOICE.md): a release is signed with the hardened runtime, which
	     denies the microphone unless the app declares it here. The release
	     overlay (packaging/release.tauri.json) names this file. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
