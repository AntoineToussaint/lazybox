node_modules/
dist/
build/
bin/
coverage/
target/
.expo/
.cache/
*.tsbuildinfo
*.log
.env
.env.*
!.env.example

# A bare `go build` in the Runner's module writes its binary beside the source
# (`lazybox` from ./cmd/lazybox, `code` from the module root). `make build-go`
# writes to bin/; check-private.mjs refuses any tracked executable.
/services/runner/code/lazybox
/services/runner/code/code
/services/runner/code/cmd/lazybox/lazybox

.codefly/
runner.config.json
playwright-report/
test-results/

# The docs site (docs-site/): VitePress writes these when its outDir and cacheDir are not set.
docs-site/.vitepress/cache/
docs-site/.vitepress/.temp/
docs-site/.vitepress/dist/

# Editor and OS files, local agent state.
.DS_Store
*.swp
*.swo
.claude/
