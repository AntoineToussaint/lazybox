{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lazybox V2",
  "identifier": "ai.lazybox.v2.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"], "category": "DeveloperTool", "macOS": { "minimumSystemVersion": "12.0" } },
  "plugins": { "http": { "scopeRedirects": true } }
}
