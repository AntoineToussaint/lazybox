---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/AntoineToussaint/lazybox';
const docs = '/docs/';
const installCmd = 'cargo install lazybox-tui';

const features = [
  {
    icon: '◉',
    title: 'Events flow to you',
    body: 'New comments, CI failures, and review requests surface automatically with read/unread tracking. No more tab-checking GitHub.',
    wide: true,
  },
  {
    icon: '⌗',
    title: 'A session per task',
    body: 'Every PR or issue becomes a workspace with an embedded terminal — Claude Code or a shell, right where the work is.',
    wide: true,
  },
  {
    icon: '⑂',
    title: 'Isolated worktrees',
    body: 'Each session gets its own git worktree from a bare clone. Switch tasks without stashing or rebasing.',
  },
  {
    icon: '⇄',
    title: 'Source-agnostic',
    body: 'GitHub is one provider. Linear, Jira, and others plug in the same way — one inbox for everything.',
  },
  {
    icon: '⌁',
    title: 'Agents, built in',
    body: 'Claude, Codex, Cursor, or any CLI — driving the repo directly with gh and git, no approval wrapper.',
  },
  {
    icon: '⇲',
    title: 'Local or remote',
    body: 'An in-process daemon by default, or split client/daemon over a Unix socket and forward it across SSH.',
    wide: true,
  },
];

const steps = [
  {
    title: 'Add a repo',
    body: 'Point lazybox at any owner/name. It polls GitHub and your PRs and issues land in the sidebar, grouped by repo.',
    code: 'owner/name',
  },
  {
    title: 'Open a workspace',
    body: 'Press Enter on a row to get an isolated git worktree, then c for Claude Code or b for a shell.',
    code: 'Enter → c',
  },
  {
    title: 'Let work come to you',
    body: 'New activity marks rows unread. Act on what needs you, merge with g m, and never refresh a browser tab again.',
    code: 'g m',
  },
];
---

<Layout>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="nav-wrap" id="nav">
    <div class="container">
      <nav class="nav">
        <a href="/" class="brand" aria-label="lazybox home">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0b0e14"></rect>
            <rect x="3.5" y="3.5" width="25" height="25" rx="5.5" fill="none" stroke="#232a38"></rect>
            <path d="M8 11l4 4-4 4" fill="none" stroke="#6ee7a8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            <line x1="15" y1="20" x2="22" y2="20" stroke="#7cc4ff" stroke-width="2.2" stroke-linecap="round"></line>
          </svg>
          lazybox
        </a>
        <div class="links">
          <a href="#features" class="hide-sm">Features</a>
          <a href="#how" class="hide-sm">How it works</a>
          <a href={docs}>Docs</a>
          <a href={repo} class="ghbtn">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            <span class="hide-sm">Star</span>
          </a>
        </div>
      </nav>
    </div>
  </div>

  <main id="main">
    <header class="hero">
      <div class="container">
        <span class="eyebrow"><span class="dot"></span> reactive PR inbox · runs in your terminal</span>
        <h1>Stop checking GitHub.<br /><span class="grad">Let it come to you.</span></h1>
        <p class="lead">
          lazybox is a reactive PR inbox in your terminal. Comments, CI failures, and
          review requests surface the moment they happen — each one a workspace with
          an embedded terminal in its own git worktree.
        </p>

        <div class="cta-row">
          <a class="btn btn-primary" href={docs}>Get started →</a>
          <a class="btn btn-ghost" href={repo}>★ Star on GitHub</a>
        </div>

        <div class="install" data-install>
          <code><span class="prompt">$</span>{installCmd}</code>
          <button class="copy" type="button" aria-label="Copy install command" data-copy={installCmd}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-icon="copy"><rect x="5" y="5" width="9" height="9" rx="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5"></path></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="check" style="display:none"><path d="M3.5 8.5l3 3 6-6"></path></svg>
          </button>
        </div>

        <div class="term" data-reveal aria-label="lazybox running in a terminal">
          <div class="bar">
            <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
            <span class="title">lazybox — inbox</span>
          </div>
          <video
            src="/demo/lazybox.mp4"
            poster="/demo/lazybox.png"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
          >
            <img src="/demo/lazybox.gif" alt="lazybox inbox with workspaces, CI status, and an embedded terminal" />
          </video>
        </div>
      </div>
    </header>

    <div class="strip">
      <div class="container">
        <div class="row">
          <span><b class="mk">⌘</b> <b>Built in Rust</b></span>
          <span><b class="mk">◇</b> Free &amp; open source</span>
          <span><b class="mk">⇲</b> Local-first, remote-ready</span>
          <span><b class="mk">⌁</b> Claude · Codex · Cursor</span>
        </div>
      </div>
    </div>

    <section id="features">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">An inbox, not a dashboard</p>
          <h2>Everything that needs you, in one place</h2>
          <p>A terminal for every task — and the work surfaces on its own.</p>
        </div>
        <div class="bento">
          {features.map((f, i) => (
            <div class={f.wide ? 'card wide' : 'card'} data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
              <div class="icon">{f.icon}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">How it works</p>
          <h2>From clone to a live terminal in minutes</h2>
          <p>Three keys to a worktree, an agent, and an inbox that triages itself.</p>
        </div>
        <div class="steps">
          {steps.map((s, i) => (
            <div class="step" data-reveal style={`transition-delay:${i * 80}ms`}>
              <span class="n">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <p style="margin-top:0.9rem"><code>{s.code}</code></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="keys-section">
      <div class="container">
        <div class="keys-grid">
          <div class="keys-copy" data-reveal>
            <p class="kicker">Terminal-native</p>
            <h2>Your hands never leave the keyboard</h2>
            <p>
              Every pane declares its own keymap; the hint bar always shows what's live.
              Navigate, spawn agents, and ship — all without reaching for a mouse.
            </p>
            <div class="keys-list">
              <div class="k"><kbd>j</kbd><kbd>k</kbd> navigate the inbox</div>
              <div class="k"><kbd>c</kbd> spawn Claude Code &nbsp;·&nbsp; <kbd>b</kbd> shell</div>
              <div class="k"><kbd>w</kbd> let lazybox pick the right prompt for the row</div>
              <div class="k"><kbd>g</kbd><kbd>m</kbd> merge &nbsp;·&nbsp; <kbd>/</kbd> search</div>
            </div>
          </div>
          <div class="keys-card" data-reveal>
            <div class="bar">
              <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
            </div>
            <pre><span class="c-dim">┌─ inbox ──────────────────────────────┐</span>
<span class="unread">● #209  Rework snippet invocation</span>      <span class="c-green">✓ ci</span>
<span class="unread">● #207  Bucket untyped workspaces</span>     <span class="c-amber">2 comments</span>
<span class="c-dim">○ #206  Wrap multi-line snippet bodies</span>  <span class="c-green">✓ ci</span>
<span class="unread">● #197  Drop bot-authored Slack msgs</span>    <span class="c-red">✗ ci failed</span>
<span class="c-dim">○ #195  Collapse out-of-scope issue</span>      <span class="c-green">merged</span>
<span class="c-dim">└──────────────────────────────────────┘</span>
  <span class="c-accent">c</span> claude  <span class="c-accent">b</span> shell  <span class="c-accent">g m</span> merge  <span class="c-accent">/</span> search</pre>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container" data-reveal>
        <h2>Your PRs, where you already live.</h2>
        <p>Free and open source. Built in Rust. Drive it entirely from the keyboard.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={docs}>Read the docs →</a>
          <a class="btn btn-ghost" href={repo}>View source</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container row">
      <span class="brand">› lazybox <span class="by">· by <a href="https://antoinetoussaint.com">Antoine Toussaint</a></span></span>
      <div class="links">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>License</a>
      </div>
    </div>
  </footer>

  <script>
    // Nav border on scroll
    const nav = document.getElementById('nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Copy-to-clipboard for the install command
    document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add('copied');
          const copy = btn.querySelector<HTMLElement>('[data-icon="copy"]');
          const check = btn.querySelector<HTMLElement>('[data-icon="check"]');
          if (copy) copy.style.display = 'none';
          if (check) check.style.display = 'block';
          setTimeout(() => {
            btn.classList.remove('copied');
            if (copy) copy.style.display = 'block';
            if (check) check.style.display = 'none';
          }, 1600);
        } catch {
          /* clipboard unavailable — no-op */
        }
      });
    });

    // Scroll reveal
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      items.forEach((el) => io.observe(el));
    }
  </script>
</Layout>
