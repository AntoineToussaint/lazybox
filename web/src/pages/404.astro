---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/AntoineToussaint/lazybox';
const docs = '/docs/';
---

<Layout title="404 — page not found · lazybox">
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="nav-wrap" id="nav">
    <div class="container">
      <nav class="nav">
        <a href="/" class="brand" aria-label="lazybox home">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0b0e14"></rect>
            <rect x="3.5" y="3.5" width="25" height="25" rx="5.5" fill="none" stroke="#232a38"></rect>
            <path d="M8 11l4 4-4 4" fill="none" stroke="#6ee7a8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            <line x1="15" y1="20" x2="22" y2="20" stroke="#7cc4ff" stroke-width="2.2" stroke-linecap="round"></line>
          </svg>
          lazybox
        </a>
        <div class="links">
          <a href={docs}>Docs</a>
          <a href={repo} class="ghbtn">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            <span class="hide-sm">Star</span>
          </a>
        </div>
      </nav>
    </div>
  </div>

  <main id="main" class="nf">
    <div class="container nf-inner">
      <span class="eyebrow"><span class="dot"></span> 404 · not found</span>
      <h1 class="nf-code">404</h1>
      <p class="nf-lead">
        That page took an isolated worktree of its own and wandered off.
        Nothing to merge here.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Back home →</a>
        <a class="btn btn-ghost" href={docs}>Read the docs</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
  }
  .nf-inner {
    text-align: center;
    padding: 4rem var(--gutter) 6rem;
  }
  .nf-code {
    font-family: var(--mono);
    font-size: clamp(5rem, 18vw, 9rem);
    line-height: 1;
    margin: 1rem 0 0.5rem;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.04em;
  }
  .nf-lead {
    max-width: 34rem;
    margin: 0 auto 2rem;
    color: var(--fg-dim);
    font-size: 1.1rem;
  }
  .nf .cta-row {
    justify-content: center;
  }
</style>
