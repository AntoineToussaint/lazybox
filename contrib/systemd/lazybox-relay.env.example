# Public TCP listener. Open this port in the host and cloud firewalls.
LAZYBOX_RELAY_LISTEN_ADDR=0.0.0.0:9443

# Hosted entitlement service. Keep this file mode 0600.
LAZYBOX_PLATFORM_URL=https://platform.lazybox.ai
LAZYBOX_PLATFORM_API_KEY=replace-me

# tracing-subscriber EnvFilter syntax.
RUST_LOG=lazybox_relay=info
