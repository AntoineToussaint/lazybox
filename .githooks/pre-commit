#!/usr/bin/env bash
# lazybox pre-commit hook.
#
# Runs the same fmt + clippy + rustdoc gates as CI so a botched format,
# a clippy warning, or a broken doc link never leaves the laptop.
# Install once: `make install-hooks`.
#
# Bypass for a one-off "I know what I'm doing" commit:
#     git commit --no-verify
# (Don't do this on the shared branch.)

set -euo pipefail

# Honor lazybox's pinned zig if present — same resolution run.sh and the
# Makefile use so anything the hook spawns picks up zig 0.15.2 instead
# of whatever brew put on PATH (ghostty's build.zig rejects 0.16).
# `make setup` drops the binary under a host-specific dir; glob for it
# rather than assuming a fixed path. A per-worktree `vendor/zig/` wins
# when present (a worktree can pin its own zig); otherwise fall back to
# the shared cache at `${LAZYBOX_ZIG_CACHE:-~/.cache/lazybox/zig}/` (one
# download shared across all worktrees).
repo_root="$(git rev-parse --show-toplevel)"
zig_cache="${LAZYBOX_ZIG_CACHE:-${HOME}/.cache/lazybox/zig}"
zig_bin=""
for root in "${repo_root}/vendor/zig" "${zig_cache}"; do
    [ -d "${root}" ] || continue
    zig_bin="$(find "${root}" -maxdepth 2 -name zig -type f 2>/dev/null | head -n1)"
    [ -n "${zig_bin}" ] && break
done
if [ -n "${zig_bin}" ]; then
    export PATH="$(dirname "${zig_bin}"):${PATH}"
fi

# 1. Format check — fastest, fails most often. Same invocation
#    the CI fmt job runs.
echo "pre-commit: cargo fmt --all -- --check"
if ! cargo fmt --all -- --check; then
    cat <<EOF >&2

pre-commit: rustfmt diff above. Run \`cargo fmt --all\` (or
\`make fmt\`) and re-commit. Bypass with \`git commit --no-verify\`
if intentional (don't do this on shared branches).
EOF
    exit 1
fi

# 2. Clippy on the staged tree. Slower but catches the things CI
#    catches before they need a re-push round-trip. Same flags CI
#    uses.
echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    cat <<EOF >&2

pre-commit: clippy warnings above. Fix them or bypass with
\`git commit --no-verify\`.
EOF
    exit 1
fi

# 3. Rustdoc with warnings-as-errors — catches broken intra-doc links
#    (`[\`Foo\`]` pointing at a symbol that isn't in scope). Same
#    RUSTDOCFLAGS + invocation the CI rustdoc job runs. Cheap once the
#    clippy build above has warmed the cache.
echo "pre-commit: RUSTDOCFLAGS=-D warnings cargo doc --no-deps --workspace"
if ! RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --workspace --quiet; then
    cat <<EOF >&2

pre-commit: rustdoc errors above (usually a broken intra-doc link —
a \`[\`Symbol\`]\` whose target isn't imported in that module). Fix the
link or bypass with \`git commit --no-verify\`.
EOF
    exit 1
fi

echo "pre-commit: ok"
