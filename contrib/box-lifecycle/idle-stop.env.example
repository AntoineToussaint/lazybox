# Drop at /etc/lazybox/idle-stop.env to tune the idle-stop timer.
# Every value has a built-in default; uncomment only what you want to change.

# Minutes of continuous idle before the box stops itself.
#LAZYBOX_IDLE_MINUTES=30

# CPU-seconds a watched agent must use between ticks to count as "working".
#LAZYBOX_IDLE_AGENT_CPU_SECS=2

# Space-separated agent process names that keep the box alive while busy.
#LAZYBOX_IDLE_AGENT_PROCS=claude codex cursor-agent aider

# SSH port an inbound tunnel lands on.
#LAZYBOX_IDLE_SSH_PORT=22

# Override the stop action entirely (skips the gcloud self-stop / shutdown path).
#LAZYBOX_IDLE_STOP_CMD=
