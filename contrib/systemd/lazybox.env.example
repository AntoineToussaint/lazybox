# lazybox service environment — copy to /etc/lazybox/<user>.env, chmod 0600,
# and fill in per box. Both units read it via EnvironmentFile.

# Per-user data + runtime root: state DB, worktrees, daemon socket. Defaults
# to ~/.lazybox when unset; the units already pin it to /home/<user>/.lazybox,
# so only set this for a non-standard home layout.
#LAZYBOX_HOME=/home/alice/.lazybox

# Bearer token the JSON API gateway (lazybox-api@) requires. Clients send it
# as `Authorization: Bearer <token>`. The gateway refuses to start without it.
# Not needed by lazybox-daemon@ (the Unix-socket daemon).
LAZYBOX_API_TOKEN=change-me

# Provider credentials the daemon runs as — it acts as this single identity
# for every connected client. Use whichever your setup needs.
#GH_TOKEN=ghp_xxx
#LINEAR_API_KEY=lin_api_xxx
