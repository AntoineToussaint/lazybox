---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/AntoineToussaint/lazybox';
const sponsors = 'https://github.com/sponsors/AntoineToussaint';
const discussions = 'https://github.com/AntoineToussaint/lazybox/discussions';
const contactEmail = 'toussaint.antoine@gmail.com';
const authorSite = 'https://antoinetoussaint.com';
const docs = '/docs/';
const workflows = '/docs/tutorials/core-workflows/';
const brewInstallCmd = 'brew install AntoineToussaint/lazybox/lazybox';
const installerCmd =
  "curl --proto '=https' --tlsv1.2 -LsSf https://github.com/AntoineToussaint/lazybox/releases/latest/download/lazybox-tui-installer.sh | sh";
const sourceInstallCmd =
  'cargo install --git https://github.com/AntoineToussaint/lazybox --locked lazybox-tui-boot';

const features = [
  {
    icon: '⌗',
    title: 'A fleet, not a tab',
    body: 'Every PR and issue becomes a workspace with its own agent. Run dozens at once — each in its own embedded terminal — and flip between them instantly without losing your place.',
    wide: true,
  },
  {
    icon: '◉',
    title: 'It pings you when an agent is stuck',
    body: 'The instant an agent hits a permission prompt or needs a decision, lazybox fires a native desktop notification and flags the row. Press ! to jump straight to it. Stop babysitting terminals.',
    wide: true,
  },
  {
    icon: '⊞',
    title: 'Start a fleet by tagging issues',
    body: 'Drop a lazybox:claude label on GitHub issues you authored or are assigned to — across one repo or many — and lazybox opens each worktree and spawns an agent on the next sweep. No TUI, no terminal. Tag an eligible triaged backlog and come back to dozens of agents already working. An optional high, medium, or low issue label picks the model and effort.',
    wide: true,
  },
  {
    icon: '⑂',
    title: 'Worktrees, handled',
    body: 'Every task gets a fresh, isolated git checkout — created automatically. No branches to make, nothing to stash, no collisions between agents running side by side. You never think about it.',
  },
  {
    icon: '⇄',
    title: 'GitHub and Linear, one inbox',
    body: 'PRs, issues, and Linear tickets surface the same way, with read/unread tracking. Mirror activity to Slack — and kick off work with an @lazybox mention.',
  },
  {
    icon: '⌁',
    title: 'Point once. lazybox routes the work',
    body: 'Press w w and lazybox turns the focused issue, CI failure, conflict, or selected review comments into the right brief. It reuses the running agent or starts your default in the task worktree. A GitHub high / medium / low tag picks its configured model and effort.',
  },
  {
    icon: '◎',
    title: 'Automation you can see',
    body: 'Press g p for one policies surface: merge on green, auto-fix CI and conflicts, and GitHub auto-merge status — every switch and override visible in one place.',
  },
  {
    icon: '↻',
    title: 'Terminals fail visibly',
    body: 'Choose splits or tabs, recall the last prompt after a restart, and inspect the final screen when an agent crashes or fails to start. Clean exits disappear; failures never do.',
    wide: true,
  },
  {
    icon: '∑',
    title: 'Route agents through your gateway',
    body: 'Set one llm_gateway_url and every spawned agent points at your own LLM gateway — lazybox injects the right base-URL env var per provider (Anthropic or OpenAI). Your API key goes straight to the gateway; the daemon never sees it.',
    wide: true,
  },
  {
    icon: '⇲',
    title: 'Local or remote',
    body: 'Runs as an in-process daemon by default, or split client and daemon over a Unix socket and forward it across SSH — heavy lifting on a remote box, inbox on your laptop.',
    wide: true,
  },
];

const steps = [
  {
    title: 'Connect your sources',
    body: 'Point lazybox at your GitHub repos and Linear. Every PR, issue, and ticket lands in one keyboard-driven inbox — grouped, tracked, read/unread.',
    code: 'owner/name',
  },
  {
    title: 'Spawn agents in parallel',
    body: 'Press a c, a x, or a u for Claude Code, Codex, or Cursor — or w w to let lazybox pick the brief. Each gets its own isolated checkout. Run as many as you like.',
    code: 'a c · a x · a u · w w',
  },
  {
    title: 'Step in only when needed',
    body: 'Agents work on their own. lazybox notifies you the moment one needs a decision — jump to it with !, unblock it, and move on.',
    code: '!',
  },
];
---

<Layout
  title="lazybox — a terminal TUI for GitHub and coding agents"
  description="A keyboard-driven terminal TUI that brings GitHub activity, managed worktrees, coding agents, and live terminals into one reactive inbox."
>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="nav-wrap" id="nav">
    <div class="container">
      <nav class="nav">
        <a href="/" class="brand" aria-label="lazybox home">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0b0e14"></rect>
            <rect x="3.5" y="3.5" width="25" height="25" rx="5.5" fill="none" stroke="#232a38"></rect>
            <path d="M8 11l4 4-4 4" fill="none" stroke="#6ee7a8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            <line x1="15" y1="20" x2="22" y2="20" stroke="#7cc4ff" stroke-width="2.2" stroke-linecap="round"></line>
          </svg>
          lazybox
        </a>
        <div class="links">
          <a href="#demos" class="hide-sm">Demos</a>
          <a href="#features" class="hide-sm">Features</a>
          <a href="#how" class="hide-sm">How it works</a>
          <a href={docs}>Docs</a>
          <a href={repo} class="ghbtn" aria-label="Star lazybox on GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            <span class="hide-sm">Star</span>
          </a>
        </div>
      </nav>
    </div>
  </div>

  <main id="main">
    <header class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="terminal-command"><span aria-hidden="true">$</span> lazybox --about</p>
          <p class="terminal-declaration">
            A terminal TUI — reactive GitHub inbox + agent fleet, keyboard-driven.
          </p>
          <h1>Let the work come to you.<br /><span>Stay in the terminal.</span></h1>
          <p class="lead">
            Events surface across your repositories while coding agents work in parallel,
            each in its own managed worktree and embedded terminal.
          </p>
          <p class="terminal-proof">Runs in your terminal. No Electron. No tab farm.</p>

          <div class="cta-row">
            <a class="btn btn-primary" href={workflows}>Explore workflows →</a>
            <a class="btn btn-ghost" href={repo}>★ Star on GitHub</a>
          </div>
        </div>

        <figure class="term" aria-labelledby="demo-caption">
          <div class="terminal-bar" aria-hidden="true">
            <span>tty://lazybox</span>
            <span>real TUI capture · inbox at scale</span>
          </div>
          <div class="demo-video" data-demo-video>
            <video
              src="/demo/01-inbox.mp4"
              poster="/demo/01-inbox.jpg"
              aria-label="lazybox inbox with workspaces, CI status, activity, and embedded agent terminals"
              data-demo
              loop
              muted
              playsinline
              preload="none"
              controls
            ><track kind="captions" src="/demo/01-inbox.vtt" srclang="en" label="English" default /></video>
            <div class="demo-overlay" data-demo-overlay aria-hidden="true"></div>
          </div>
          <figcaption id="demo-caption">
            <span aria-hidden="true">└─</span> GitHub workspaces on the left; live agent terminals on the right.
          </figcaption>
        </figure>
      </div>

      <div class="container">
        <div class="install-options">
          <div class="install-option install-option-primary">
            <p class="install-label">Homebrew <span>Prebuilt · recommended</span></p>
            <div class="install" data-install>
              <code><span class="prompt">$</span>{brewInstallCmd}</code>
              <button class="copy" type="button" aria-label="Copy Homebrew install command" data-copy={brewInstallCmd}>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-icon="copy"><rect x="5" y="5" width="9" height="9" rx="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5"></path></svg>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="check" style="display:none"><path d="M3.5 8.5l3 3 6-6"></path></svg>
              </button>
            </div>
          </div>

          <details class="install-more">
            <summary>Other options: installer script or advanced source build</summary>
            <div class="install-alternatives">
              <div class="install-option">
                <p class="install-label">Installer script <span>Prebuilt</span></p>
                <div class="install" data-install>
                  <code><span class="prompt">$</span>{installerCmd}</code>
                  <button class="copy" type="button" aria-label="Copy installer script command" data-copy={installerCmd}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-icon="copy"><rect x="5" y="5" width="9" height="9" rx="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5"></path></svg>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="check" style="display:none"><path d="M3.5 8.5l3 3 6-6"></path></svg>
                  </button>
                </div>
              </div>

              <div class="install-option install-option-source">
                <p class="install-label">Advanced / from source</p>
                <div class="install" data-install>
                  <code><span class="prompt">$</span>{sourceInstallCmd}</code>
                  <button class="copy" type="button" aria-label="Copy source install command" data-copy={sourceInstallCmd}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-icon="copy"><rect x="5" y="5" width="9" height="9" rx="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5"></path></svg>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="check" style="display:none"><path d="M3.5 8.5l3 3 6-6"></path></svg>
                  </button>
                </div>
                <p class="install-caption">
                  Compiles the current main branch (HEAD) locally. Requires Rust 1.88+,
                  Zig 0.15.2, and a native C/C++ toolchain.
                </p>
              </div>
            </div>
          </details>

          <p class="install-guide">
            <a href="/docs/tutorials/quickstart/#1-install">See every install method and platform.</a>
          </p>
        </div>
      </div>
    </header>

    <section id="demos" class="demos">
      <div class="container">
        <p class="kicker" style="text-align:center">Real terminal, real workload</p>
        <h2 style="text-align:center">A few of the workflows I run all day.</h2>
        <div class="demos-grid">
          <figure class="demo-item" data-reveal>
            <div class="term">
              <div class="bar"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span><span class="title">snippets</span></div>
              <div class="demo-video" data-demo-video>
                <video src="/demo/02-snippets.mp4" poster="/demo/02-snippets.jpg" aria-label="Firing reusable snippets into an agent" loop muted playsinline preload="none" controls><track kind="captions" src="/demo/02-snippets.vtt" srclang="en" label="English" default /></video>
                <div class="demo-overlay" data-demo-overlay aria-hidden="true"></div>
              </div>
            </div>
            <figcaption><b>Snippets</b> — reusable prompts fired into any agent, most-recently-used first.</figcaption>
          </figure>
          <figure class="demo-item" data-reveal>
            <div class="term">
              <div class="bar"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span><span class="title">github controls</span></div>
              <div class="demo-video" data-demo-video>
                <video src="/demo/03-policies.mp4" poster="/demo/03-policies.jpg" aria-label="The github leader menu: merge, auto-merge on green, policies, reviewers and labels" loop muted playsinline preload="none" controls><track kind="captions" src="/demo/03-policies.vtt" srclang="en" label="English" default /></video>
                <div class="demo-overlay" data-demo-overlay aria-hidden="true"></div>
              </div>
            </div>
            <figcaption><b>GitHub controls</b> — merge, auto-merge on green, automation policies, reviewers and labels, all from one <code>g</code> menu.</figcaption>
          </figure>
          <figure class="demo-item" data-reveal>
            <div class="term">
              <div class="bar"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span><span class="title">worktree + agent</span></div>
              <div class="demo-video" data-demo-video>
                <video src="/demo/04-spawn.mp4" poster="/demo/04-spawn.jpg" aria-label="Spawning a git worktree and a live agent for one task" loop muted playsinline preload="none" controls><track kind="captions" src="/demo/04-spawn.vtt" srclang="en" label="English" default /></video>
                <div class="demo-overlay" data-demo-overlay aria-hidden="true"></div>
              </div>
            </div>
            <figcaption><b>Transparent worktrees</b> — every task gets its own git worktree and a live agent, managed for you.</figcaption>
          </figure>
          <figure class="demo-item" data-reveal>
            <div class="term">
              <div class="bar"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span><span class="title">github auto-work</span></div>
              <div class="demo-video" data-demo-video>
                <video src="/demo/05-autowork.mp4" poster="/demo/05-autowork.jpg" aria-label="Tagging a GitHub issue and an agent picking it up" loop muted playsinline preload="none" controls><track kind="captions" src="/demo/05-autowork.vtt" srclang="en" label="English" default /></video>
                <div class="demo-overlay" data-demo-overlay aria-hidden="true"></div>
              </div>
            </div>
            <figcaption><b>GitHub-driven work</b> — CI failures, reviews and issues surface in the inbox; tag one and an agent picks it up.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div class="strip">
      <div class="container">
        <div class="row">
          <span><b class="mk">⌁</b> Claude Code · Codex · Cursor · custom CLIs</span>
          <span><b class="mk">⑂</b> Transparent task worktrees</span>
          <span><b class="mk">◉</b> Stable, accurate agent status</span>
          <span><b class="mk">↻</b> Restart-safe tmux sessions</span>
          <span><b class="mk">]N</b> Workflow memory</span>
        </div>
      </div>
    </div>

    <aside class="founder-note" aria-labelledby="founder-note-title">
      <div class="container">
        <div class="founder-note-inner" data-reveal>
          <p class="founder-note-title" id="founder-note-title">A note on where this is.</p>
          <p>
            We’re in the stone age of agent coding. lazybox is <strong>not the solution</strong> —
            it’s the scaffolding I built to survive the mess while I work on the real thing.
            But it’s <strong>by far the most productive I can be right now</strong>; nothing else
            I’ve tried is close. Use it, break it, tell me what’s missing. It’s a stopgap, and
            I’m building past it.
          </p>
        </div>
      </div>
    </aside>

    <section id="features">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">An inbox, not a dashboard</p>
          <h2>Built to run a lot of agents at once</h2>
          <p>Many agents in flight, one calm inbox — and it tells you which one needs you.</p>
        </div>
        <div class="bento">
          {features.map((f, i) => (
            <div class={f.wide ? 'card wide' : 'card'} data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
              <div class="icon">{f.icon}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">How it works</p>
          <h2>From zero to a fleet in three steps</h2>
          <p>Wire up your sources, spawn agents in parallel, and let the inbox triage itself.</p>
        </div>
        <div class="steps">
          {steps.map((s, i) => (
            <div class="step" data-reveal style={`transition-delay:${i * 80}ms`}>
              <span class="n">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <p style="margin-top:0.9rem"><code>{s.code}</code></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container" data-reveal>
        <h2>Spend your attention where it changes the outcome.</h2>
        <p>Start with a task, keep its context through Git and GitHub, and let the reactive inbox bring you back only when needed.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={workflows}>Start with the core workflows →</a>
          <a class="btn btn-ghost" href={repo}>View source</a>
        </div>
      </div>
    </section>

    <section id="support" class="support-section">
      <div class="container">
        <div class="support-card" data-reveal>
          <div>
            <p class="kicker">Open source, built in public</p>
            <h2>Support lazybox.</h2>
            <p>
              If lazybox saves you time, a sponsorship helps fund maintenance,
              releases, and the infrastructure behind the project. The
              open-source TUI and daemon remain available to everyone.
            </p>
          </div>
          <a class="btn btn-ghost" href={sponsors}>♡ Sponsor on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container row">
      <span class="brand">› lazybox <span class="by">· by <a href={authorSite}>Antoine Toussaint</a></span></span>
      <div class="links">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <a href={discussions}>Discussions</a>
        <a href={`mailto:${contactEmail}`}>Contact</a>
        <a href={sponsors}>Sponsor</a>
        <a href={`${repo}/blob/main/LICENSE`}>License</a>
      </div>
    </div>
  </footer>

  <script>
    import { captionParts, wireDemoCaption } from '../scripts/demo-captions.js';

    const nav = document.getElementById('nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add('copied');
          const copy = btn.querySelector<HTMLElement>('[data-icon="copy"]');
          const check = btn.querySelector<HTMLElement>('[data-icon="check"]');
          if (copy) copy.style.display = 'none';
          if (check) check.style.display = 'block';
          setTimeout(() => {
            btn.classList.remove('copied');
            if (copy) copy.style.display = 'block';
            if (check) check.style.display = 'none';
          }, 1600);
        } catch {
          /* clipboard unavailable — no-op */
        }
      });
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const demo = document.querySelector<HTMLVideoElement>('[data-demo]');
    if (reduce && demo) {
      demo.pause();
      demo.removeAttribute('autoplay');
    }
    // Styled caption overlay driven by each demo's WebVTT <track>. The .vtt is
    // the single source of truth: the native (toggleable) track and this chip
    // overlay read the same cues, so they can never drift. A cue like
    // "⌨ ]]s — open the picker" becomes a keycap chip + description; any other
    // cue is shown as plain description text. See scripts/demo-captions.js for
    // the parsing and active-caption rules (unit-tested there).
    document.querySelectorAll<HTMLElement>('[data-demo-video]').forEach((wrap) => {
      const video = wrap.querySelector<HTMLVideoElement>('video');
      const overlay = wrap.querySelector<HTMLElement>('[data-demo-overlay]');
      const track = video?.textTracks?.[0];
      if (!video || !overlay || !track) return;

      wireDemoCaption(video, track, (text) => {
        overlay.textContent = '';
        if (text === null) {
          overlay.classList.remove('on');
          return;
        }
        const { key, text: desc } = captionParts(text);
        const line = document.createElement('div');
        line.className = 'demo-overlay-line';
        if (key !== null) {
          const chip = document.createElement('kbd');
          chip.className = 'demo-overlay-key';
          chip.textContent = key;
          line.append(chip);
        }
        const span = document.createElement('span');
        span.textContent = desc;
        line.append(span);
        overlay.append(line);
        overlay.classList.add('on');
      });
    });

    const items = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      items.forEach((el) => io.observe(el));
    }
  </script>
</Layout>
